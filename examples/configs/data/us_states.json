  "metadata": {
    "name": "United States - 50 States Dataset",
    "version": "1.0.0",
    "description": "All 50 US states with geographic, demographic, and historical characteristics"
  },
  "identification_fields": ["name"],
  "feature_fields": [
    {
      "name": "region",
      "display_name": "Geographic Region",
      "type": "categorical"
    },
    {
      "name": "size_category",
      "display_name": "Size Category",
      "type": "categorical"
    },
    {
      "name": "population_millions",
      "display_name": "Population",
      "type": "numerical",
      "bucketing": {
        "method": "custom",
        "buckets": [
          {"label": "Small (<3M)", "min": 0, "max": 3},
          {"label": "Medium (3-7M)", "min": 3, "max": 7},
          {"label": "Large (7-15M)", "min": 7, "max": 15},
          {"label": "Very Large (15M+)", "min": 15, "max": null}
        ]
      }
    },
    {
      "name": "has_ocean_coast",
      "display_name": "Has Ocean Coastline",
      "type": "boolean"
    },
    {
      "name": "admission_era",
      "display_name": "Statehood Era",
      "type": "categorical"
    },
    {
      "name": "capital_size",
      "display_name": "Capital City Size",
      "type": "categorical"
    },
    {
      "name": "time_zone_count",
      "display_name": "Number of Time Zones",
      "type": "numerical",
      "bucketing": {
        "method": "custom",
        "buckets": [
          {"label": "One Zone", "min": 1, "max": 2},
          {"label": "Multiple Zones", "min": 2, "max": null}
        ]
      }
    },
    {
      "name": "has_mountains",
      "display_name": "Has Major Mountains",
      "type": "boolean"
    }
  ],
