{
  "metadata": {
    "name": "Classic Movies Dataset",
    "version": "1.0.0",
    "description": "30 acclaimed movies with genre, era, and award characteristics"
  },
  "identification_fields": ["title"],
  "feature_fields": [
    {
      "name": "primary_genre",
      "display_name": "Primary Genre",
      "type": "categorical"
    },
    {
      "name": "era",
      "display_name": "Era",
      "type": "categorical"
    },
    {
      "name": "runtime_minutes",
      "display_name": "Runtime",
      "type": "numerical",
      "bucketing": {
        "method": "custom",
        "buckets": [
          {"label": "Short (<100 min)", "min": 0, "max": 100},
          {"label": "Standard (100-130 min)", "min": 100, "max": 130},
          {"label": "Long (130-180 min)", "min": 130, "max": 180},
          {"label": "Epic (180+ min)", "min": 180, "max": null}
        ]
      }
    },
    {
      "name": "rating",
      "display_name": "Age Rating",
      "type": "categorical"
    },
    {
      "name": "won_best_picture",
      "display_name": "Won Best Picture Oscar",
      "type": "boolean"
    },
    {
      "name": "is_franchise",
      "display_name": "Part of Franchise",
      "type": "boolean"
    },
    {
      "name": "setting",
      "display_name": "Primary Setting",
      "type": "categorical"
    },
    {
      "name": "tone",
      "display_name": "Overall Tone",
      "type": "categorical"
    }
  ],
