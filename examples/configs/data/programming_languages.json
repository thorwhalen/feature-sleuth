  "identification_fields": ["name"],
  "feature_fields": [
    {
      "name": "primary_paradigm",
      "display_name": "Primary Paradigm",
      "type": "categorical"
    },
    {
      "name": "typing_system",
      "display_name": "Typing System",
      "type": "categorical"
    },
    {
      "name": "primary_use_case",
      "display_name": "Primary Use Case",
      "type": "categorical"
    },
    {
      "name": "year_created",
      "display_name": "Year Created",
      "type": "numerical",
      "bucketing": {
        "method": "custom",
        "buckets": [
          {"label": "Vintage (1950-1980)", "min": 1950, "max": 1980},
          {"label": "Classic (1980-1995)", "min": 1980, "max": 1995},
          {"label": "Modern (1995-2010)", "min": 1995, "max": 2010},
          {"label": "Contemporary (2010+)", "min": 2010, "max": null}
        ]
      }
    },
    {
      "name": "compiled_or_interpreted",
      "display_name": "Execution Model",
      "type": "categorical"
    },
    {
      "name": "has_garbage_collection",
      "display_name": "Has Garbage Collection",
      "type": "boolean"
    },
    {
      "name": "is_object_oriented",
      "display_name": "Supports OOP",
      "type": "boolean"
    },
    {
      "name": "syntax_style",
      "display_name": "Syntax Style",
      "type": "categorical"
    }
  ],
