      "type": "categorical"
    },
    {
      "name": "government_type",
      "display_name": "Government Type",
      "type": "categorical"
    },
    {
      "name": "is_coastal",
      "display_name": "Has Coastline",
      "type": "boolean"
    },
    {
      "name": "climate_zone",
      "display_name": "Primary Climate",
      "type": "categorical"
    },
    {
      "name": "has_red_in_flag",
      "display_name": "Red in Flag",
      "type": "boolean"
    },
    {
      "name": "has_blue_in_flag",
      "display_name": "Blue in Flag",
      "type": "boolean"
    },
    {
      "name": "num_neighbors",
      "display_name": "Number of Land Neighbors",
      "type": "numerical",
      "bucketing": {
        "method": "custom",
        "buckets": [
          {"label": "Island (0)", "min": 0, "max": 1},
          {"label": "Few (1-3)", "min": 1, "max": 4},
          {"label": "Several (4-8)", "min": 4, "max": 9},
          {"label": "Many (9+)", "min": 9, "max": null}
        ]
      }
    }
